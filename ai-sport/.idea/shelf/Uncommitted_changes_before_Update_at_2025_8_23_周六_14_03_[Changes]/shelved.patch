<+><template>\n  <div class=\"progress-page\">\n    <div class=\"progress-container\">\n      <!-- 页面标题 -->\n      <div class=\"page-header\">\n        <div class=\"header-content\">\n          <el-icon class=\"header-icon\"><TrendCharts /></el-icon>\n          <div class=\"header-text\">\n            <h1 class=\"page-title\">运动进度</h1>\n            <p class=\"page-subtitle\">查看你的训练成果和进度分析</p>\n          </div>\n        </div>\n      </div>\n\n      <!-- 整体统计卡片 -->\n      <div class=\"stats-grid\">\n        <el-card class=\"stat-card\" shadow=\"never\">\n          <div class=\"stat-content\">\n            <el-icon class=\"stat-icon completed\"><Trophy /></el-icon>\n            <div class=\"stat-details\">\n              <span class=\"stat-value\">{{ overallStats.completedWorkouts }}</span>\n              <span class=\"stat-label\">已完成运动</span>\n            </div>\n          </div>\n        </el-card>\n        \n        <el-card class=\"stat-card\" shadow=\"never\">\n          <div class=\"stat-content\">\n            <el-icon class=\"stat-icon progress\"><Clock /></el-icon>\n            <div class=\"stat-details\">\n              <span class=\"stat-value\">{{ overallStats.totalReps }}</span>\n              <span class=\"stat-label\">总完成次数</span>\n            </div>\n          </div>\n        </el-card>\n        \n        <el-card class=\"stat-card\" shadow=\"never\">\n          <div class=\"stat-content\">\n            <el-icon class=\"stat-icon streak\"><Calendar /></el-icon>\n            <div class=\"stat-details\">\n              <span class=\"stat-value\">{{ overallStats.streakDays }}</span>\n              <span class=\"stat-label\">连续训练天数</span>\n            </div>\n          </div>\n        </el-card>\n        \n        <el-card class=\"stat-card\" shadow=\"never\">\n          <div class=\"stat-content\">\n            <el-icon class=\"stat-icon average\"><Star /></el-icon>\n            <div class=\"stat-details\">\n              <span class=\"stat-value\">{{ overallStats.averageCompletion }}%</span>\n              <span class=\"stat-label\">平均完成率</span>\n            </div>\n          </div>\n        </el-card>\n      </div>\n\n      <!-- 活跃计划进度 -->\n      <el-card v-if=\"activePlan\" class=\"active-plan-progress\" shadow=\"never\">\n        <template #header>\n          <div class=\"card-header\">\n            <el-icon class=\"header-icon\"><DocumentCopy /></el-icon>\n            <span class=\"header-title\">当前计划进度</span>\n          </div>\n        </template>\n\n        <div class=\"plan-progress-content\">\n          <div class=\"plan-info\">\n            <h3 class=\"plan-title\">{{ activePlan.title }}</h3>\n            <p class=\"plan-description\">{{ activePlan.description }}</p>\n            \n            <div class=\"plan-meta\">\n              <span class=\"meta-item\">\n                <el-icon><Calendar /></el-icon>\n                第 {{ activePlan.progress.currentWeek }} / {{ activePlan.durationWeeks }} 周\n              </span>\n              <span class=\"meta-item\">\n                <el-icon><Clock /></el-icon>\n                {{ activePlan.progress.completedWorkouts }} / {{ activePlan.progress.totalWorkouts }} 项完成\n              </span>\n            </div>\n          </div>\n\n          <div class=\"plan-progress-chart\">\n            <div class=\"progress-circle\">\n              <el-progress \n                type=\"circle\" \n                :percentage=\"activePlan.progress.completionRate\"\n                :width=\"120\"\n                :stroke-width=\"8\"\n                :color=\"getProgressColor(activePlan.progress.completionRate)\"\n              >\n                <template #default=\"{ percentage }\">\n                  <span class=\"progress-text\">{{ percentage }}%</span>\n                </template>\n              </el-progress>\n            </div>\n            <div class=\"progress-details\">\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">整体进度</span>\n                <span class=\"detail-value\">{{ activePlan.progress.completionRate }}%</span>\n              </div>\n              <div class=\"detail-item\">\n                <span class=\"detail-label\">预计完成</span>\n                <span class=\"detail-value\">{{ formatDate(estimatedEndDate) }}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </el-card>\n\n      <!-- 运动类型分析 -->\n      <el-card class=\"workout-types-analysis\" shadow=\"never\">\n        <template #header>\n          <div class=\"card-header\">\n            <el-icon class=\"header-icon\"><PieChart /></el-icon>\n            <span class=\"header-title\">运动类型分析</span>\n          </div>\n        </template>\n\n        <div class=\"workout-types-grid\">\n          <div \n            v-for=\"(type, index) in workoutTypeStats\" \n            :key=\"index\"\n            class=\"workout-type-card\"\n          >\n            <div class=\"type-header\">\n              <span class=\"type-emoji\">{{ getWorkoutEmoji(type.workoutType) }}</span>\n              <span class=\"type-name\">{{ getWorkoutName(type.workoutType) }}</span>\n            </div>\n            \n            <div class=\"type-stats\">\n              <div class=\"stat-row\">\n                <span class=\"stat-label\">总次数</span>\n                <span class=\"stat-value\">{{ type.totalReps }}</span>\n              </div>\n              <div class=\"stat-row\">\n                <span class=\"stat-label\">训练次数</span>\n                <span class=\"stat-value\">{{ type.sessions }}</span>\n              </div>\n              <div class=\"stat-row\">\n                <span class=\"stat-label\">平均强度</span>\n                <span class=\"stat-value\">{{ type.averageIntensity }}/5</span>\n              </div>\n            </div>\n\n            <div class=\"type-progress\">\n              <el-progress \n                :percentage=\"type.completionRate\"\n                :stroke-width=\"6\"\n                :show-text=\"false\"\n                :color=\"getProgressColor(type.completionRate)\"\n              />\n              <span class=\"progress-label\">完成率 {{ type.completionRate }}%</span>\n            </div>\n          </div>\n        </div>\n      </el-card>\n\n      <!-- 最近训练记录 -->\n      <el-card class=\"recent-workouts\" shadow=\"never\">\n        <template #header>\n          <div class=\"card-header\">\n            <el-icon class=\"header-icon\"><List /></el-icon>\n            <span class=\"header-title\">最近训练记录</span>\n            <el-button type=\"primary\" size=\"small\" @click=\"viewAllWorkouts\">\n              查看全部\n            </el-button>\n          </div>\n        </template>\n\n        <div class=\"workouts-timeline\">\n          <div \n            v-for=\"workout in recentWorkouts\" \n            :key=\"workout._id\"\n            class=\"timeline-item\"\n          >\n            <div class=\"timeline-dot\">\n              <span class=\"workout-emoji\">{{ getWorkoutEmoji(workout.workoutType) }}</span>\n            </div>\n            \n            <div class=\"timeline-content\">\n              <div class=\"workout-header\">\n                <h4 class=\"workout-title\">{{ workout.workoutName }}</h4>\n                <span class=\"workout-date\">{{ formatDate(workout.createdAt) }}</span>\n              </div>\n              \n              <div class=\"workout-stats\">\n                <span class=\"stat-item\">\n                  <el-icon><Trophy /></el-icon>\n                  {{ workout.totalReps }} 次\n                </span>\n                <span class=\"stat-item\">\n                  <el-icon><Clock /></el-icon>\n                  {{ Math.round(workout.actualDuration / 60) }} 分钟\n                </span>\n                <span class=\"stat-item\">\n                  <el-icon><Star /></el-icon>\n                  {{ workout.averageStandardLevel }}% 标准度\n                </span>\n              </div>\n\n              <div v-if=\"workout.fromPlan\" class=\"plan-badge\">\n                <el-tag size=\"small\" type=\"primary\">来自训练计划</el-tag>\n              </div>\n            </div>\n          </div>\n        </div>\n      </el-card>\n\n      <!-- 加载状态 -->\n      <div v-if=\"loading\" class=\"loading-section\">\n        <el-skeleton :rows=\"5\" animated />\n      </div>\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref, onMounted, computed } from 'vue'\nimport { useRouter } from 'vue-router'\nimport { ElMessage } from 'element-plus'\nimport {\n  TrendCharts,\n  Trophy,\n  Clock,\n  Calendar,\n  Star,\n  DocumentCopy,\n  PieChart,\n  List\n} from '@element-plus/icons-vue'\nimport { useAuth } from '@/composables/useAuth'\n\nconst router = useRouter()\nconst { apiRequest } = useAuth()\n\n// 响应式数据\nconst loading = ref(true)\nconst activePlan = ref<any>(null)\nconst recentWorkouts = ref<any[]>([])\nconst workoutTypeStats = ref<any[]>([])\nconst overallStats = ref({\n  completedWorkouts: 0,\n  totalReps: 0,\n  streakDays: 0,\n  averageCompletion: 0\n})\n\n// 计算属性\nconst estimatedEndDate = computed(() => {\n  if (!activePlan.value || !activePlan.value.startDate) return '未知'\n  \n  const startDate = new Date(activePlan.value.startDate)\n  const durationDays = activePlan.value.durationWeeks * 7\n  const endDate = new Date(startDate.getTime() + durationDays * 24 * 60 * 60 * 1000)\n  \n  return endDate.toLocaleDateString('zh-CN')\n})\n\n// 加载数据\nconst loadProgressData = async () => {\n  try {\n    loading.value = true\n    \n    // 并行请求多个API\n    const [plansResponse, workoutsResponse, statsResponse] = await Promise.all([\n      apiRequest('/plans?status=active'),\n      apiRequest('/workouts?limit=10&sort=-createdAt'),\n      apiRequest('/workouts/stats')\n    ])\n\n    // 活跃计划\n    if (plansResponse.status === 'success' && plansResponse.data.plans.length > 0) {\n      activePlan.value = plansResponse.data.plans[0]\n    }\n\n    // 最近训练记录\n    if (workoutsResponse.status === 'success') {\n      recentWorkouts.value = workoutsResponse.data.workouts || []\n    }\n\n    // 统计数据\n    if (statsResponse.status === 'success') {\n      const stats = statsResponse.data\n      overallStats.value = {\n        completedWorkouts: stats.totalWorkouts || 0,\n        totalReps: stats.totalReps || 0,\n        streakDays: stats.currentStreak || 0,\n        averageCompletion: Math.round(stats.averageCompletion || 0)\n      }\n      \n      workoutTypeStats.value = stats.workoutTypeStats || []\n    }\n\n  } catch (error) {\n    console.error('加载进度数据失败:', error)\n    ElMessage.error('加载数据失败，请稍后重试')\n  } finally {\n    loading.value = false\n  }\n}\n\n// 工具函数\nconst getWorkoutEmoji = (type: string) => {\n  const map: Record<string, string> = {\n    'push-up': '\uD83D\uDCAA',\n    'squat': '\uD83E\uDDB5'\n  }\n  return map[type] || '\uD83C\uDFC3'\n}\n\nconst getWorkoutName = (type: string) => {\n  const map: Record<string, string> = {\n    'push-up': '俯卧撑',\n    'squat': '深蹲'\n  }\n  return map[type] || type\n}\n\nconst getProgressColor = (percentage: number) => {\n  if (percentage >= 100) {\n    return '#67c23a' // 绿色\n  } else if (percentage >= 70) {\n    return '#e6a23c' // 橙色\n  } else if (percentage >= 30) {\n    return '#409eff' // 蓝色\n  } else {\n    return '#f56c6c' // 红色\n  }\n}\n\nconst formatDate = (dateString: string) => {\n  const date = new Date(dateString)\n  const today = new Date()\n  const diffTime = today.getTime() - date.getTime()\n  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24))\n  \n  if (diffDays === 0) {\n    return '今天'\n  } else if (diffDays === 1) {\n    return '昨天'\n  } else if (diffDays < 7) {\n    return `${diffDays}天前`\n  } else {\n    return date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' })\n  }\n}\n\nconst viewAllWorkouts = () => {\n  router.push('/history')\n}\n\n// 生命周期\nonMounted(() => {\n  loadProgressData()\n})\n</script>\n\n<style scoped>\n.progress-page {\n  min-height: calc(100vh - 140px);\n  background: #f8fafc;\n  padding: 20px;\n}\n\n.progress-container {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n/* 页面标题 */\n.page-header {\n  text-align: center;\n  margin-bottom: 20px;\n}\n\n.header-content {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n}\n\n.header-icon {\n  font-size: 2.5rem;\n  color: #667eea;\n}\n\n.page-title {\n  font-size: 2rem;\n  font-weight: 700;\n  color: #2d3748;\n  margin: 0;\n}\n\n.page-subtitle {\n  font-size: 1rem;\n  color: #718096;\n  margin: 4px 0 0 0;\n}\n\n/* 统计卡片网格 */\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-bottom: 24px;\n}\n\n.stat-card {\n  border: none;\n  border-radius: 16px;\n  overflow: hidden;\n  transition: all 0.3s ease;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.stat-card:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);\n}\n\n.stat-content {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 4px;\n}\n\n.stat-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.5rem;\n  color: white;\n}\n\n.stat-icon.completed {\n  background: linear-gradient(135deg, #48bb78, #38a169);\n}\n\n.stat-icon.progress {\n  background: linear-gradient(135deg, #4299e1, #3182ce);\n}\n\n.stat-icon.streak {\n  background: linear-gradient(135deg, #ed8936, #dd6b20);\n}\n\n.stat-icon.average {\n  background: linear-gradient(135deg, #9f7aea, #805ad5);\n}\n\n.stat-details {\n  flex: 1;\n}\n\n.stat-value {\n  display: block;\n  font-size: 1.75rem;\n  font-weight: 700;\n  color: #2d3748;\n  line-height: 1;\n}\n\n.stat-label {\n  font-size: 0.875rem;\n  color: #718096;\n  margin-top: 4px;\n}\n\n/* 活跃计划进度 */\n.active-plan-progress {\n  border: none;\n  border-radius: 16px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.plan-progress-content {\n  display: flex;\n  align-items: center;\n  gap: 32px;\n}\n\n.plan-info {\n  flex: 1;\n}\n\n.plan-title {\n  font-size: 1.5rem;\n  font-weight: 600;\n  color: #2d3748;\n  margin: 0 0 8px 0;\n}\n\n.plan-description {\n  color: #718096;\n  margin: 0 0 16px 0;\n}\n\n.plan-meta {\n  display: flex;\n  gap: 24px;\n  flex-wrap: wrap;\n}\n\n.meta-item {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.9rem;\n  color: #4a5568;\n}\n\n.plan-progress-chart {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 16px;\n}\n\n.progress-circle {\n  display: flex;\n  justify-content: center;\n}\n\n.progress-text {\n  font-size: 1.2rem;\n  font-weight: 600;\n  color: #2d3748;\n}\n\n.progress-details {\n  text-align: center;\n}\n\n.detail-item {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.detail-label {\n  font-size: 0.875rem;\n  color: #718096;\n}\n\n.detail-value {\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: #2d3748;\n}\n\n/* 运动类型分析 */\n.workout-types-analysis {\n  border: none;\n  border-radius: 16px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.workout-types-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 20px;\n}\n\n.workout-type-card {\n  padding: 20px;\n  background: #f8fafc;\n  border-radius: 12px;\n  border: 1px solid #e2e8f0;\n  transition: all 0.3s ease;\n}\n\n.workout-type-card:hover {\n  background: #edf2f7;\n  transform: translateY(-2px);\n}\n\n.type-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n.type-emoji {\n  font-size: 1.5rem;\n}\n\n.type-name {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #2d3748;\n}\n\n.type-stats {\n  margin-bottom: 16px;\n}\n\n.stat-row {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 8px;\n}\n\n.stat-row .stat-label {\n  font-size: 0.875rem;\n  color: #718096;\n}\n\n.stat-row .stat-value {\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: #2d3748;\n}\n\n.type-progress {\n  margin-top: 12px;\n}\n\n.progress-label {\n  display: block;\n  font-size: 0.8rem;\n  color: #4a5568;\n  margin-top: 6px;\n  text-align: center;\n}\n\n/* 最近训练记录 */\n.recent-workouts {\n  border: none;\n  border-radius: 16px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.workouts-timeline {\n  position: relative;\n}\n\n.timeline-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 16px;\n  margin-bottom: 24px;\n  position: relative;\n}\n\n.timeline-item:not(:last-child)::after {\n  content: '';\n  position: absolute;\n  left: 20px;\n  top: 44px;\n  bottom: -24px;\n  width: 2px;\n  background: #e2e8f0;\n}\n\n.timeline-dot {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #667eea, #764ba2);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  z-index: 1;\n}\n\n.workout-emoji {\n  font-size: 1.2rem;\n}\n\n.timeline-content {\n  flex: 1;\n  background: #f8fafc;\n  padding: 16px;\n  border-radius: 12px;\n  border: 1px solid #e2e8f0;\n}\n\n.workout-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.workout-title {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #2d3748;\n  margin: 0;\n}\n\n.workout-date {\n  font-size: 0.875rem;\n  color: #718096;\n}\n\n.workout-stats {\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n  margin-bottom: 8px;\n}\n\n.stat-item {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 0.875rem;\n  color: #4a5568;\n}\n\n.plan-badge {\n  margin-top: 8px;\n}\n\n/* 卡片标题 */\n.card-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.header-title {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #2d3748;\n}\n\n/* 加载状态 */\n.loading-section {\n  padding: 40px 20px;\n}\n\n/* 响应式设计 */\n@media (max-width: 768px) {\n  .progress-page {\n    padding: 15px;\n  }\n  \n  .stats-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .plan-progress-content {\n    flex-direction: column;\n    text-align: center;\n  }\n  \n  .workout-types-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .workout-stats {\n    justify-content: center;\n  }\n}\n</style>\n
